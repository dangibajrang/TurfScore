# Server
NODE_ENV=development
PORT=15190
MONGODB_URI=mongodb://127.0.0.1:27017/turfscore
CLIENT_URL=http://localhost:5190

# JWT (used from Phase 2 — placeholders required for config completeness)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
PASSWORD_RESET_EXPIRES_IN=1h

# Logging
LOG_LEVEL=info

# Local image uploads are stored under server/uploads and served at /uploads/*
# Max size: 2 MB. Allowed: JPEG, PNG, WebP, GIF.

# Password reset: in development the API returns/logs `devResetUrl` (no email SMTP yet).
# Production should send the link by email and never expose the token in the API response.

# Development seed credentials (npm run seed) — never use in production:
# ADMIN  admin@example.com / Password123!
# USER   arjun@example.com / Password123!
